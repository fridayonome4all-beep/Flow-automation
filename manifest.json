{
  "manifest_version": 3,
  "name": "FlowBatch - Google Flow Automator",
  "short_name": "FlowBatch",
  "version": "2.0.0",
  "description": "Bulk-generate images and videos in Google Flow with queues, references, video keyframes, upscaling, and auto-resume.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FlowBatch"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "shared/schema.js",
        "shared/parse.js",
        "shared/db.js",
        "content/selectors.js",
        "content/refs.js",
        "content/driver.js",
        "content/runner.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
